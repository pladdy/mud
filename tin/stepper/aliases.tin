#nop build a map of valid dirs;
#var valid_stepper_dirs[n] {valid};
#var valid_stepper_dirs[s] {valid};
#var valid_stepper_dirs[e] {valid};
#var valid_stepper_dirs[w] {valid};
#var valid_stepper_dirs[nw] {valid};
#var valid_stepper_dirs[ne] {valid};
#var valid_stepper_dirs[sw] {valid};
#var valid_stepper_dirs[se] {valid};

#alias _go_in_dir {
  log.info Stepper is moving $dir_to_go;
  #regexp {"$dir_to_go"} {{_|#\w+}} {
    log.info Stepper running direction as command: $dir_to_go;
    $dir_to_go;
  } {
    #send !$dir_to_go;
    #map move $dir_to_go;
  };
}

#alias read_stepper_path {
  #local path tin/stepper/paths/%1.txt;
  #scan file $path {
    #var last_dir {};
    #var start_of_line true;
    #var skip_line false;

    #list stepper_path clear;
    #parse {&0} {c} {
      #if {"$start_of_line" == "true" && "$c" == "#"} {
        #var skip_line true;
      };
      #if {"$c" == "\n"} {
        #list stepper_path add {$last_dir};
        #var last_dir {};
        #var start_of_line true;
        #var skip_line false;
      };
      #elseif {"$skip_line" != "true"} {
        #var last_dir {$last_dir$c};
        #var start_of_line false;
      };
    };
    #list stepper_path add {$last_dir};
  };
}

#alias _load_stepper_path {
  #list stepper_path size stepper_path_length;
  #if {$stepper_path_length > 0} {
    #list stepper_path clear;
    #var stepper_path_rooms_visited 0;
    #var stepper_path_rooms 0;
  };
  #else {
    read_stepper_path %1;
    #list stepper_path size stepper_path_rooms;

    #if {$stepper_path_rooms == 0} {
      log.warn No path loaded, turning stepper off;
      #delay {1} {stepper off};
      log.info Possible paths:;
      print_system_output ls tin/stepper/paths;
    };
    #else {
      #var stepper_path_name {%1};
      log.info Loaded $stepper_path_rooms stepper_path rooms;
    };
  };
}

#alias _mission_ask_accept {
  #send !mission ask;
  #6 #send !mission accept;
}

#alias _reset_prompt_ticker {
  #unticker prompt;
  #ticker {prompt} {#if {$rounds_in_combat == 0} {auto_kill}} {2};
}

#alias _transform_monster_name {
  log.debug Trying to parse mosnter name %0;

  #var monster_name %0;
  #replace monster_name {[M]} {};
  #replace monster_name {\\x7B%d\\x7D} {};
  #replace monster_name {\\x7b%d\\x7d} {};
  #replace monster_name {attacking you!} {};
  #replace monster_name {[{.+}]} {};
  #replace monster_name {({.+})} {};
  #replace monster_name {<{.+}>} {};
  #replace monster_name {.$} {};
  #format monster_name {%l} $monster_name;
  #format monster_name {%p} $monster_name;
  log.debug Parsed monster name is $monster_name;
}

#alias auto_kill {
  #nop _reset_prompt_ticker;
  #list {seen_monsters} {size} {seen_monster_count};

  #if {"$stepper" == "on" && "$player_present" == "true"} {
    log.info Player preent, moving;
    take_a_step;
  };
  #elseif {"$stepper" == "on" && $seen_monster_count == 0 && "$player_present" == "false"} {
    log.info No monsters, moving;
    #if {"$item_present" == "true"} {
      #if {"$flying" == "true"} {#send !swoop all};
      #else {#send !get all};
    };
    take_a_step;
  };
  #elseif {$seen_monster_count > 0 && "$under_attack" == "false" && "$player_present" == "false"} {
    log.debug monster present, attack;
    #send !kill @transform_mob{$seen_monsters[1]};
    #var under_attack true;
  };

  #if {"$under_attack" == "true"} {ttl_no_monsters off};
}

#alias before_step_hook {#nop;}

#alias add_challenge_knight_steps {
  #loop 1 6 loop {
    #list stepper_path insert 1 glance;
    #list stepper_path insert 1 challenge;
    #math {stepper_path_rooms} {$stepper_path_rooms_visited + 2};
  };
}

#alias keep_cardinal_dirs {
  #list cardinal_exits clear;

  #foreach {$available_exits} {exit} {
    #if {"$valid_stepper_dirs[$exit]" == "valid"} {
      #list cardinal_exits add $exit;
    };
  }
}

#alias load_non_monsters {
  #script {non_monsters} {cat tin/stepper/non_monsters.txt | grep -v '#'};
  log.debug non_monsters: $non_monsters;
}

#alias parse_exits {
  log.debug parse_exists called with %0;
  #var available_exits {};
  #var room_string %0;
  #var exit_str "";

  #regexp {$room_string} {(%+)$} {#var exit_str &1};

  #if {"$exit_str" != ""} {
    #replace {exit_str} {,} {;};
  };
  #var available_exits $exit_str;

  #unvar room_string;
  #unvar exit_str;
}

#alias remove_seen_monster {
  #format {mob_to_remove} {%l} {%0};

  #foreach *seen_monsters[] {index} {
    #regexp {$seen_monsters[$index]} {$mob_to_remove} {
      #list seen_monsters {delete} {$index};
    };
  };
}

#alias set_entered_from {
  #switch {"$step_dir"} {
    #case {"n"} {#var entered_from s};
    #case {"s"} {#var entered_from n};
    #case {"w"} {#var entered_from e};
    #case {"e"} {#var entered_from w};
    #case {"nw"} {#var entered_from se};
    #case {"ne"} {#var entered_from sw};
    #case {"sw"} {#var entered_from ne};
    #case {"se"} {#var entered_from nw};
    #default {#unvar entered_from};
  }
}

#alias set_under_attack {
  #regexp {%0} { attacking you!} {#var under_attack true};
  #regexp {%0} { [%d%] attacking} {#var under_attack true};
}

#alias stepper {
  #switch {"%1"} {
    #case {"on"} {
      log.info Enabling stepping. 'stepper off' to disable.;
      #format {stepper_started} {%T};
      #unvar step_dir;
      #unvar entered_from;
      #delay {2} {
        #var stepper on;
        #send !glance;
      };
      tracker on;
      ttl_stepper on;
      #nop only turn on monster found TTL if not in combat;
      #if {$enemy <= 0} {ttl_no_monsters on};
      #ticker {prompt} {
        #if {$rounds_in_combat == 0} {#send !glance};
      } {2};
      
      #if {"%2" != ""} {
        log.warn Stepper path specified, using %2;
        #list stepper_path clear;
        #var stepper_path_rooms_visited 0;
        #var stepper_path_rooms 0;
        _load_stepper_path %2;
      };
      #send !brief on no;
    };
    #case {"off"} {
      log.info Disabling stepping. 'stepper on' to re-enable.;
      sound_beeps;
      #var stepper off;
      #unvar seen_monster_count;
      ttl_stepper;
      ttl_no_monsters off;
      #undelay reactivate_stepper;
      #unticker prompt;
      tracker off;
      #send !brief on yes;
    };
    #case {"clear"} {
      log.info Clearing stepper path;
      #list stepper_path clear;
      #var stepper_path_rooms_visited 0;
      #var stepper_path_rooms 0;
    };
    #case {"party"} {
      #if {"%2" == "remove"} {
        log.info Removing party member '%3' from ignore list;
        #format player {%l} {%3};
        #list stepper_party find $player index;
        #list stepper_party delete $index;
        #list tells_blocklist find $player index;
        #list tells_blocklist delete $index;
        #unvar index;
      };
      #elseif {"%2" == "add"} {
        log.info Adding party member '%3' to ignore list;
        #format player {%l} {%3};
        #list stepper_party add %3;
        #list tells_blocklist add %3;
      };
      #else {
        log.info Party member list: $stepper_party;
      };
    };
    #case {"status"} {
      #nop recalculate % completion;
      #var stepper_path_loaded $stepper_path;
      read_stepper_path $stepper_path_name;
      #list stepper_path size stepper_path_rooms;
      #var stepper_path $stepper_path_loaded;
      #unvar stepper_path_loaded;
      #list stepper_path size stepper_path_rooms_left;
      #math stepper_path_rooms_visited {$stepper_path_rooms - $stepper_path_rooms_left};
      #math {stepper_completion} {$stepper_path_rooms_visited / $stepper_path_rooms * 100.00};
      log.info Stepper $stepper_path_name is $stepper_completion% ( $stepper_path_rooms_visited / $stepper_path_rooms ) done;
      #unvar stepper_completion
    };
    #default {
      log.warn Invalid syntax: stepper on|off|clear [stepper path file name];
    }
  };
}

#alias step_fast {
  #list stepper_path size stepper_path_length;
  #if {$stepper_path_length > 0} {
    #%1 {
      #var dir_to_go $stepper_path[1];
      _go_in_dir;
      #list stepper_path delete 1;
      #math {stepper_path_rooms_visited} {$stepper_path_rooms_visited + 1};
    }
  }
}

#alias stepper_run {
  map lock;
  #format {run_to} {%l} {%1};
  #unevent {MAP ENTER ROOM};
  #send !ansi off;
  #map run $run_to;
  refresh_map_on_enter;
  map_refresh;
  #unvar run_to;
  #send !ansi on;
  #send !glance;
  #nop force a delay, try to avoid skipping rooms;
  #script {sleep 1};
  #delay 1 {#send !brief on no};
}

#alias take_a_step {
  before_step_hook;
  keep_cardinal_dirs;
  set_entered_from;
  
  #list cardinal_exits find $entered_from entered_from_index;

  #if {$entered_from_index > 0} {
    #list cardinal_exits delete $entered_from_index;
  };

  #list cardinal_exits size cardinal_exit_count;
  #list stepper_path size stepper_path_length;

  #if {$stepper_path_length > 0} {
    #var dir_to_go $stepper_path[1];
    #math {stepper_path_rooms_visited} {$stepper_path_rooms_visited + 1};
    #list stepper_path delete 1;
    #var step_dir $dir_to_go;
    log.debug Using stepper path to move;
    _go_in_dir;
    #if {$stepper_path_length == 1} {
      #nop TODO handle this better...;
      log.info Reached end of path;
      send_email Stepper is turning off due to path completion;
      stepper off;
    }
  };
  #elseif {$cardinal_exit_count > 0} {
    #var dir_to_go @choose_a_dir{$cardinal_exits};
    #var step_dir $dir_to_go;
    _go_in_dir;
  };
  #else {
    log.info Moving back to entered from: $entered_from;
    #var step_dir $entered_from;
    $entered_from;
  };

  #unvar entered_from_index;
}

#alias tracker {
  #if {"%0" == "on"} {
    log.info Enabling tracking. 'tracker off' to disable.;
    #send !aset room_short white+[RS] +reset;
    #send !aset look_monster hired+[M] +reset;
    #send !aset look_player higreen+[P] +reset;
    #send !aset look_armor hicyan+[A] +reset;
    #send !aset look_object hicyan+[O] +reset;
    #send !aset look_other hicyan+[o] +reset;
    #send !aset look_weapon hicyan+[W] +reset;
    #send !brief on no;
    load_non_monsters;
    #var tracker on;
  };
  #elseif {"%0" == "off"} {
    log.info Disabling tracking. 'tracker on' to re-enable.;
    #send !aset room_short;
    #send !aset look_monster;
    #send !aset look_player;
    #send !aset look_armor;
    #send !aset look_object;
    #send !aset look_other;
    #send !aset look_weapon;
    #send !brief on yes;
    #unvar non_monsters;
    #var tracker off;
  }
}

#alias ttl_no_monsters {
  #local TTL 120;
  #local ticker_name ttl_no_monsters;

  #if {"%0" == "on"} {
    #undelay $ticker_name;
    #ticker {$ticker_name} {
      #if {$enemy == 0} {
        log.warn Turning off stepper, no monsters seen since TTL started;
        send_email Stepper is turning off due to no monsters;
        stepper off;
        ttl_stepper_hook;
      };
      #else {
        ttl_no_monsters on;
      };
    } {$TTL};
    #var ttl_no_monsters_active true;
  };
  #else {
    #undelay $ticker_name;
    #var ttl_no_monsters_active false;
  };
}

#alias ttl_stepper {
  #nop  15 minutes;
  #local TTL 900;
  #local ticker_name ttl_stepper;

  #if {"%0" == "on"} {
    log.info Activating stepper TTL for $TTL seconds.;

    #undelay $ticker_name;
    #ticker {$ticker_name} {
      log.warn No input received in a while.  Disabling stepper.;
      send_email Stepper is turning off due to inactivity;
      stepper off;
      ttl_stepper_hook;
    } {$TTL};
  };
  #else {
    #undelay $ticker_name;
  };
}

#alias ttl_stepper_hook {
  #nop;
}