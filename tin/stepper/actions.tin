#nop Track monsters when stepping through rooms;

#nop Note: Mud events for a mob dying are defined in tin/default/kills.tin;
#nop       removing_seen_monster and activating the TTL are handled in those;
#nop       events;

#alias add_room_to_visited {
  #local current_room $map[current_room];

  #if {"%0" != ""} {
    #replace current_room {$map[current_room]} {%0};
  };

  #list visited_rooms find $current_room visited_room_check;
  #if {$visited_room_check == 0} {
    #list visited_rooms add $current_room;
  };
  #nop track last time room was visited;
  #format visited_time {%T};
  #var visited_room_times[$current_room] $visited_time;
  #unvar visited_time;
}

#nop Room Short trigger;
#action {^%!{[> ]*}[RS] %1} {
  _reset_prompt_ticker;

  #list seen_monsters clear;
  #var seen_monster_count 0;
  #var under_attack false;
  #var player_present false;
  #var item_present false;
  #var tried_to_auto_kill false;
  parse_exits %1;
  add_room_to_visited;
}

#nop Monster trigger;

#alias stepper_monster_trigger {
  log.debug monster trigger firing;

  set_under_attack %1;
  #local mob_on_blacklist {@mob_is_blacklisted{%1}};

  log.debug mob_on_blacklist? $mob_on_blacklist;

  #if {"$mob_on_blacklist" == "false"} {
    _transform_monster_name %1;
    #list {seen_monsters} {find} {$monster_name} {index_if_seen};

    #if {$index_if_seen == 0} {
      #list {seen_monsters} {add} {$monster_name};
    };
  };
}

#action {^%!{[> ]*}[M] %1} {
  stepper_monster_trigger {%1};
}

#nop Prompt;
#action {^{[> ]+}$} {
  _reset_prompt_ticker;
  #if {"$tried_to_auto_kill" == "false"} {
    #if {"$stepper" == "on"} {
      auto_kill;
      #var tried_to_auto_kill true;
    };
  };

  #list items_picked_up size items_picked_up_count;
  #if {"$stepper" == "on" && $items_picked_up_count > 0} {
    log.info Putting all in bags: $items_picked_up;
    pba;
    #list items_picked_up clear;
  };
}

#action {^[P] %1} {
  log.debug Tracker found player present, player %1;
  #format {player} {%l} {%1};
  #var skip_player false;

  #foreach { $stepper_party[%*] } {party_player} {
    #regexp {$player} {$party_player} {
      log.debug Party member, skipping;
      #var skip_player true;
    };
  };

  #if {"$skip_player" == "false"} {
    #var player_present {true};
    #if {"$stepper" == "on"} {
      sound_beeps;
      #delay player_present_delay {
        #if {"$player_present" == "true"} {
          log.warn Player still present!  Trying to move.;
          take_a_step;
        };
      } 5;
    };
  };
}

#action {^[{A|O|o|W}] %1} {
   log.debug Tracker found item present, item %1;
   #var item_present {true};
}

#action {^{[> ]*}%1: Ok.$} {
  #if {"$stepper" == "on"} {
    #local item %1;
    log.debug Picked up item: $item;
    #regexp {$item} {green capsule} {#send !compress green capsule};
    #regexp {$item} {bronze key} {#send !keep key};
    #regexp {$item} {dense wooden hammer} {#send !keep hammer};
    #regexp {$item} {gold coin} {#nop} {#list items_picked_up add {$item}};
  };
}

#action {^There is no %1 here.} {
  #regexp {%1} {reason to}
    {#nop;}
    {
      #list {seen_monsters} {find} {%1} {mob_index};

      #if {$mob_index > 0} {
        #list {seen_monsters} {delete} {$mob_index};
      };

      #send !glance;
  };
}

#action {^%!{[> ]*}The Warrior of the Mist stands before you, blocking your progress.} {
  log.warn Movement blocked, trying to step again;
  take_a_step;
}

#action {^%!{[> ]*}There are no other challenge partners available right now.$} {
  log.info No more challenge knights, removing stepper path steps.;
  #if {"$stepper" == "on"} {
    #while {"$stepper_path[1]" == "challenge" || "$stepper_path[1]" == "glance"} {
      #list stepper_path delete 1;
    }
  }
}