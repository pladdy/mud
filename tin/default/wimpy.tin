#nop Define wimpy_commands per guild profile;
#alias wimpy_commands {#nop;}

#alias wd {
  #switch {"%1"} {
    #case "n" {#send !wimpydir north};
    #case "s" {#send !wimpydir south};
    #case "e" {#send !wimpydir east};
    #case "w" {#send !wimpydir west};
    #case "nw" {#send !wimpydir northwest};
    #case "ne" {#send !wimpydir northeast};
    #case "sw" {#send !wimpydir southwest};
    #case "se" {#send !wimpydir southeast};
    #case "u" {#send !wimpydir up};
    #case "d" {#send !wimpydir down};
    #default {#send !wimpydir %0};
  }
}

#alias _default_wimpy_commands {
  #showme <110>Wimpy firing!;
  #send !hp;
  sound_beeps;
  #if {"$stepper" == "on"} {
    log.warn Wimpied, disabling stepper;
    send_email Turning off stepper due to wimpy firing, will re-enter in 20s;
    stepper off;
    #delay {20} {
      #send !$wimpy_from_dir;
      stepper on;
    };
  };
}

#action {^Your legs tried to run away, but failed.$} {
  _default_wimpy_commands;
  wimpy_commands;
}

#action {^Your legs run away with you!} {
  #showme <110>Wimpy was a random direction!;
  _default_wimpy_commands;
  wimpy_commands;
}

#action {^Your legs run away with you %1.$} {
  _default_wimpy_commands;

  #switch {"%1"} {
    #case "north" {#var wimpy_to_dir n; #wimpy_from_dir s;};
    #case "south" {#var wimpy_to_dir s; #wimpy_from_dir n;};
    #case "east" {#var wimpy_to_dir e; #wimpy_from_dir w;};
    #case "west" {#var wimpy_to_dir w; #wimpy_from_dir e;};
    #case "northwest" {#var wimpy_to_dir nw; #wimpy_from_dir se;};
    #case "northeast" {#var wimpy_to_dir ne; #wimpy_from_dir sw;};
    #case "southwest" {#var wimpy_to_dir sw; #wimpy_from_dir ne;};
    #case "southeast" {#var wimpy_to_dir se; #wimpy_from_dir nw;};
    #case "up" {#var wimpy_to_dir u; #wimpy_from_dir d;};
    #case "down" {#var wimpy_to_dir d; #wimpy_from_dir u;};
    #default {#var wimpy_to_dir %1; #wimpy_from_dir %1;};
  };
  #map move $wimpy_to_dir;

  wimpy_commands;
}

#action {^Your wimpy is now set to: %1%} {
  #var wimpy_value %1;
}

#action {^Wimpy: %1 (%2%)} {
  #var wimpy_value %2;
  #format {wimpy_value} {%p} {$wimpy_value};
}

#action {^Wimpy removed you brave soul you} {
  #var wimpy_value 0;
}

#action {^Wimpy:   OFF}{
  #var wimpy_value 0;
}