#alias load_auction_allow_list {
    log.debug Loading auction allow list: $auction[allow_list_file];
    #if {"$auction[allow_list_file]" != ""} {
        log.info Loading auction allow list;
        #script {auction[allow]} {cat $auction[allow_list_file] | grep -v '#'};
    };
    #else {
        log.info Loading default auction allow list;
        #script {allows} {cat tin/default/auction_allow.txt | grep -v '#'};

        #list allows simplify;
        #list allow clear;
        #list auction[allow] clear;
        #var auction[allow_price] {};

        #foreach {$allows} {allow} {
            #list allow explode {:};
            #list auction[allow] add $allow[1];
            #var auction[allow_price][$allow[1]] {$allow[2]};
        };
        #unvar allow;
        #unvar allows;
    };
}

#alias auto_auction {
  #if {"$auction[auto]" != "true"} {
    #showme <170>Auto auction enabled.;
    #var auction[auto] true;
  };
   #else {
    #showme <170>Auto auction disabled.;
    #var auction[auto] false;
  }
}

#action {^%!{[> ]*}[Auction] Robert : Up for bids: %1} {
    sound auction;
    #var auction[item] %1;
    load_auction_allow_list;
}

#nop [Auction] Robert : Cable has requested 0 as the opening offer.;
#action {^%!{[> ]*}[Auction] Robert : %1 has requested {[,\d]+} as the opening offer.} {
    #var auction[seller] %1;
    #format {auction[seller]} {%l} {$auction[seller]};
    #var auction[offer] %2;
    #replace {auction[offer]} {,} {};

    load_auction_allow_list;
    #if {"$auction[max]" == ""} {#var auction[max] 2500};

    #if {"$auction[seller]" != "$character"} {
        send_email $auction[item] is being auctioned;
        #foreach { $auction[allow][%*] } {allowed_item} {
            #if {"$allowed_item" != ""} {
                #regexp {$auction[item]} {%i$allowed_item} {
                    #if {"$auction[auto]" == "on" && 
                         $auction[offer] <= $auction[allow_price][$allowed_item]
                        } {
                        log.info Match on $allowed_item, bidding on $auction[item];
                        #math rando {2 d 4};
                        #delay $rando {#send !abid $auction[offer]};
                    };
                };
            };
        };
    };
}

#highlight {^%!{[> ]*}O: %1 %s%2%s:%sSmall Figurine %2$} {underscore <faf>}