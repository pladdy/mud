#action {Resurrection tithe required: %1 coins} {
  #send !accept;
}

#action {^%!{[> ]*}Galan booms: Then it shall be so!$} {
  #map goto 3k_chapel;
}

#action {^%!{[> ]*}You die.$} {
  #if {"$stepper" == "on"} {
    log.warn You died fool!;
    stepper off;
  };
  #undelay reactivate_stepper;
  send_email You died fool!\n\nRoom $map[current_room]: $map[room_info][area], $map[room_info][data];
}
