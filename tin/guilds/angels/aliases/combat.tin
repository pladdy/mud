#alias attempt_awe {
  #if {@enough_distance_and_time{} && @should_awe{}} {
    #var angel[last_awed_area] $highest_area;
    #send !awe $highest_area;
    decrement_ts 2;
    reduce_high_advantage_and_resort;
  };
}

#alias attempt_beyond_time {
  #local MIN_DIV_FOR_BT 250;

  #if {"$use_beyond_time" == "true" &&
       $gp2 > $MIN_DIV_FOR_BT &&
       $pct_gp1 < 0.4} {
    #send !manifest beyond time;
  };
}

#alias attempt_circle {
  #if {"$use_circle" == "true" && @distance_closed{} && $enemy > 0} {#send !circle};
}

#alias attempt_consecrate {
  #local MIN_DIV_FOR_CO 200;
  #if {"$use_consecrate" == "true" && 
       "$consecrate_active" != "true" &&
       $gp2 > $MIN_DIV_FOR_CO && 
       @combat_rounds_left{} > 10} {
    #send !consecrate;
  }
}

#alias attempt_disengage {
  #if {"$use_disengage" == "true" &&
       @distance_closed{} &&
       "$can_disengage" == "true"} {
    #send !disengage $disengage_distance;
    decrement_ts $disengage_distance;
  };
}

#alias attempt_dive {
  #delay 2 {
    #if {"$use_dive" == "true" && "$already_dove" == "false" && $enemy > 10} {
      #send !dive;
    };
  };
}

#alias attempt_divine_strike {
  #if {@should_swing{} == 1} {divine_strike};
}

#alias attempt_immortality {
  #local MIN_DIV_FOR 175;
  #if {
    "$use_immortality" == "true" 
    && $gp2 > $MIN_DIV_FOR 
    && ($pct_hp < 1 || "$angel[pinned]" == "true")
  } {
    #send !immortality;
  };
}

#alias attempt_lunge {
  #if {@should_lunge{}} {
    #send !lunge $highest_area;
    decrement_ts $angel[distance];
    reduce_high_advantage_and_resort;
  };
}

#alias attempt_presage {
  #nop presage fails if you have < 20 advantage;
  #local MIN_ADV 20;

  #if {"$use_presage" == "true" && @distance_closed{}} {
    #if {$adv_sort[4][2] > $MIN_ADV} {
      #send !presage $adv_sort[4][1];
      reduce_advantage $adv_sort[4][1];
    };
    #elseif {$adv_sort[3][2] > $MIN_ADV} {
      #send !presage $adv_sort[3][1];
      reduce_advantage $adv_sort[3][1];
    };
    #elseif {$adv_sort[2][2] > $MIN_ADV} {
      #send !presage $adv_sort[2][1];
      reduce_advantage $adv_sort[2][1];
    };
    #elseif {$adv_sort[1][2] > $MIN_ADV} {
      #send !presage $adv_sort[1][1];
      reduce_advantage $adv_sort[1][1];
    };
    decrement_ts 1;
    sort_advantages;
  }
}

#alias attempt_providence {
  #if {"$use_providence" == "true" &&
       @enough_distance_and_time{} &&
       !@should_retribution{} &&
       $adv_sort[1][2] > $providence_at} {
    #send !providence $adv_sort[1][1];
    decrement_ts 1;
    reduce_high_advantage_and_resort;
  };
}

#alias attempt_quietus {
  #if {"$use_quietus" == "true" && @should_swing{} == 1} {
    #send !quietus $highest_area;
    decrement_ts 3;
    reduce_high_advantage_and_resort;
  };
}

#alias attempt_radiance {
  #if {"$use_radiance" == "true" && $pct_hp < 80 && $gp2 > 150} {
    #send !radiance;
  };
}

#alias attempt_renewed_light {
  #local MIN_END_FOR_RL 100;
  #local MIN_DIV_FOR_RL 200;

  #if {"$use_renewed_light" == "true" &&
       $gp2 > $MIN_DIV_FOR_RL &&
       $gp3 < $MIN_END_FOR_RL} {
    #send !manifest renewed light;
  };
}

#alias attempt_retribution {
  #if {@enough_distance_and_time{} && @should_retribution{}} {
    retribution
  };
}

#alias attempt_shine {
  #if {$gp2 > 100 && $yang > $shine_at} {#send !shine;};
}

#alias attempt_swing {
  #if {@should_swing{} == 1} {
    attempt_awe;
    attempt_retribution;
    attempt_divine_strike;
    attempt_quietus;
  };
}

#alias attempt_dmg_swing {
  #if {@should_swing{} == 1} {
    attempt_retribution;
    attempt_divine_strike;
    attempt_quietus;
  };
}

#alias attempt_traverse {
  #local MIN_TRAVERSE_DISTANCE 6;

  #if {"$use_traverse" == "true"} {
    #if {$traverse_distance <= $MIN_TRAVERSE_DISTANCE || "$can_disengage" == "false"} {
      #send !traverse toward;
      decrement_ts 1;
    };
    #else {
      #send !traverse away;
      decrement_ts 1;
    };
  };
}

#alias awe {
  #switch {"%0"} {
    #case {"on"} {#var use_awe true};
    #case {"off"} {#var use_awe false};
    #case {"foes"} {
      #if {"$awe_foes" == "true"} {
        log.info Setting awe back to normal;
        #var {awe_foes} {false};
      };
      #else {
        log.info Turning awe on as much as possible.;
        #var {awe_foes} {true};
      };
    };
    #case {"help"} {
      #showme Usage:;
      #showme   awe_foes on: turn awe on;
      #showme   awe_foes off: turn awe off;
      #showme   awe_foes foes: Prioritize using awe over strikes;
      #showme   awe_foes: Use awe at the highest advantage location;
    };
    #default {
      #send !awe %0;
      decrement_ts 2;
      reduce_high_advantage_and_resort;
    };
  };
}

#alias awe_at {
  #if {@length{%1} > 0} {
    log.info Setting awe_at_hp_pct to %1;
    #var awe_at_hp_pct %1;
  };
  #else {
    log.info To set what hp % you awe at, pass in an int 1-100.;
    log.info Current awe_at_hp_pct: $awe_at_hp_pct%.;
  };
}

#alias consecrate {
  #if {"%1" == "on"} {
    log.info Turning auto-consecrate on;
    #var use_consecrate true;
  };
  #elseif {"%1" == "off"} {
    log.info Turning auto-consecrate off;
    #var use_consecrate false;
  };
  #else {
    #send !use_consecrate;
  };
}

#alias decrement_ts {
  #math {gp1} {$gp1 - %1};
}

#alias deup {
  #send !aegis;
  #send !manifest wings;
  #send !manifest halo;
  #send !fly;
}

#alias dis {
  #if {"%1" == ""} {#send !disengage 1};
  #else {#send !disengage %1};
}

#alias disengage {
  #switch {"%0"} {
    #case {"on"} {
      log.info Turning auto-disengage on;
      #var use_disengage true;
    };
    #case {"off"} {
      log.info Turning auto-disengage off;
      #var use_disengage false;
    };
    #case {"help"} {
      #showme Usage:;
      #showme   disengage on: Turn auto-disengage on;
      #showme   disengage off: Turn auto-disengage off;
      #showme   disengage: Disengage 1 distance;
      #showme   disengage <number>: Disengage <number> distance;
    };
    #case {""} {#send !disengage 1};
    #default {#send !disengage %0};
  };
}

#function distance_closed {
  #if {$angel[distance] == 0} {#return 1} {#return 0};
}

#alias divine_strike {
  #send !divine strike $highest_area;
  decrement_ts 2;
  reduce_high_advantage_and_resort;
}

#alias _dq {
  #list dq_list create %0;
  #local dq_string {};
  #local dq_count 0;

  #if {@length{%1} > 0} {
    #foreach { $dq_list[%*] } {arg} {
      #if {@length{$arg} > 0} {
        #nop Add comma if more than one defense option is given;
        #if {$dq_count > 0} { #format dq_string {%s%s} {$dq_string} {,} };

        #switch {"$arg"} {
          #case "v" { #format dq_string {%s%s} {$dq_string} {void} };
          #case "p" { #format dq_string {%s%s} {$dq_string} {parry} };
          #case "b" { #format dq_string {%s%s} {$dq_string} {block} };
          #case "ri" { #format dq_string {%s%s} {$dq_string} {riposte} };
          #case "re" { #format dq_string {%s%s} {$dq_string} {reversal} };
        };

        #math {dq_count} {$dq_count + 1};
        #if {$dq_count >= 5} {#break};
      };
    };

    #if {@length{$dq_string} > 0} {
      #send !defensequeue clear;

      #if {$dq_count == 1} { #send !defensequeue $dq_string,none; }
                           { #send !defensequeue $dq_string;      };
    };
  };
  #else {
    log.info To change, pass in an ordered list of powers.  Ex: dq v p b re ri;
    #send !defensequeue;
  };
  #unvar dq_list;
}

#alias dq {
  #switch {"%0"} {
    #case {"gxp"} {
      dq c;
      #send !defensequeue reversal,parry,riposte,block,void;
    };
    #case {"o"} {
      dq c;
      #send !defensequeue parry,riposte,void,block;
    };
    #case {"c"} {#send !defensequeue clear};
    #case {"d"} {
      dq c;
      #send !defensequeue void,block,parry,riposte;
    };
    #case {"help"} {
      #showme Usage:           dq gxp|o|c|d|help;
      #showme Or custom order: dq p ri v b (parry,riposte,void,block)
    };
    #default {
      #if {"%0" != ""} {_dq %0};
      #else {#send !defensequeue};
    };
  };
}

#function enough_distance_and_time {
  #if {@distance_closed{} && $gp1 > $min_ts} {
    #return 1;
  };
  #else {
    #return 0;
  };
}

#alias en {
  #if {"%1" == ""} {#send !engage 1};
  #else {#send !engage %1};
}

#alias providence_at {
  #if {@length{%1} > 0} {
    log.info Setting to %1;
    #var providence_at %1;
  };
  #else {
    log.info Current setting: $providence_at%.;
  };
}

#alias reduce_advantage {
  #local area %1;

  #if {"$area" == "lo" || "$area" == "li" || "$area" == "hi" || "$area" == "ho"} {
    #math {advantages[$area]} {$advantages[$area] / 2};  
  };
}

#alias reduce_high_advantage {
  #math {advantages[$highest_area]} {$advantages[$highest_area] / 2};
}

#alias reduce_high_advantage_and_resort {
  reduce_high_advantage;
  sort_advantages;
}

#alias retribution {
  #send !retribution $highest_area;
  decrement_ts 1;
  reduce_high_advantage_and_resort;
}

#alias rise {
  #if {$enemy > 0 && ($angel[distance] < 2 || $gp2 < 100)} {
    #if {$angel[distance] < 2} {
      log.warn Can't rise due to distance ($angel[distance]), trying again next round!;
    };
    #else {
      log.warn Can't rise due to divinity ($gp2), trying again next round!;
    };
    #delay 2 {rise};
  };
  #else {#send !rise};
}

#alias _with_rebirths {
  #send !wimpy 0;
  #send !reaction clear;
  #send !panic off;
}

#alias set_wimpy {
  #if {$wimpy_value > 0 && $angel[rebirths] > 0 && $enemy > 0} {
    _with_rebirths;
  };
  #if {$wimpy_value == 0 && $angel[rebirths] == 0 && $enemy > 0} {
    #send !wimpy 50;
    #send !reaction 1200 radiance;
    #send !panic radiance/80%/1;
  };
}

#function should_awe {
  #if {
    "$use_awe" == "true" &&
    "$awed" != "true" &&
    ("$awe_foes" == "true" || $pct_hp < $awe_at_hp_pct || "$angel[pinned]" == "true")
  } {#return 1};
  #else {#return 0};
}

#function should_lunge {
  #if {$angel[distance] >= 1
       && $adv_sort[1][2] > $lunge_at 
       && $gp1 > $lunge_min_ts} {
    #return 1;
  };
  #else {#return 0};
}

#function should_retribution {
  #if {"$use_retribution" == "true" &&
       $retributions >= $retribution_at_hits &&
       $adv_sort[1][2] > $swing_at} {
    #return 1;
  };
  #else {#return 0};
}

#function should_swing {
  #if {@enough_distance_and_time{} && $adv_sort[1][2] > $swing_at} {
    #return 1;
  };
  #else {#return 0};
}

#alias sort_advantages {
  #nop sort them in descending order by value (k: location, v: advantage);
  #var i {1};
  #list adv_sort clear;

  #foreach {ho;hi;lo;li} {loc} {
    #if {$i == 1} {
      #var adv_sort[$i] { {1}{$loc}{2}{$advantages[$loc]} };
    } {
      #var j {1};
      #var found {0};

      #foreach $adv_sort[%*] {item} {
        #if { $advantages[$loc] > $adv_sort[$j][2] } {
          #list adv_sort insert $j { {1}{$loc}{2}{$advantages[$loc]} };
          #var found {1};
          #break;
        };

        #math {j} {$j + 1};
        #replace {j} {.00} {};
      };

      #if {$found == 0} {
        #list adv_sort add $j;
        #list adv_sort insert $j { {1}{$loc}{2}{$advantages[$loc]} };
        #list adv_sort delete -1;
      };
    };

    #math {i} {$i + 1};
  };

  #var highest_area $adv_sort[1][1];
}

#alias swing_at {
  #if {@length{%1} > 0} {
    log.info Setting swing to %1% advantage.;
    #var swing_at %1;
  };
  #else {
    log.info Swinging at $swing_at% advantage.;
  }
}

#alias take_swing {
  #if {@should_awe{}} {awe};
  #elseif {@should_retribution{}} {retribution};
  #else {divine_strike};
}