#action {^%!{[> ]*}3Kingdoms welcomes you back from linkdeath.$} {
  #send !hp;
  #send !i;
  #send !ff;
}

#action {^%!{[> ]*}$MAGE_FAMILIAR darts out of the room.$} {
  #var mage_familiar_present false;
}

#action {^%!{[> ]*}$MAGE_FAMILIAR darts into the room.$} {
  #var mage_familiar_present true;
}

#action {^%!{[> ]*}$MAGE_FAMILIAR.$} {
  #var mage_familiar_present true;
}

#action {^%!{[> ]*}[M] $MAGE_FAMILIAR.$} {
  #var mage_familiar_present true;
}

#action {^%!{[> ]*}The Golem calls for help!} {
  #send !kill golem;
  #send !cast polymorph other on golem;
}

#action {^%!{[> ]*}You need some basic construction materials to create a golem.$} {
  #if {"$mage_familiar_present" == "true"} {
    #send !ffetch materials;
    #var mage_familiar_present false;
  };
}

#action {^%!{[> ]*}$MAGE_FAMILIAR hands something to %1.$} {
  #format who {%l} {%1};
  #if {"$who" == "$character"} {#send !keep all};
}

#action {^%!{[> ]*}$MAGE_FAMILIAR says: Woa, wtf?!  Where'd you go?$} {
  #var mage_familiar_present true;
}

#nop stepper/area specific actions
#action {^%!{[> ]*}[M] %1 (adamant)} {
  stepper_monster_trigger {%0};
  log.warn energy immune mob, switching damage type;
  #send !cast perform as 1000/cast disintegrate;
  dtrig #send !cast perform as 1000/cast implosion;
} {1}

#action {^%!{[> ]*}[M] Lost Soul of the Zodiac} {
  stepper_monster_trigger {%0};
  #delay 2 {
    log.warn Lost soul in room, trying to target;
    #send !kill soul;
    #send !po soul;
  };
} {1}