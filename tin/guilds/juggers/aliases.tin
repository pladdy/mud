#alias _ammo {
    #var jugger_ammo_type %1;
    #send !su assault %1;
}

#alias ammo {
  #switch {"%1"} {
    #case {"edged"} {_ammo %1};
    #case {"blunt"} {_ammo %1};
    #case {"fire"} {_ammo %1};
    #case {"ice"} {_ammo %1};
    #case {"acid"} {_ammo %1};
    #case {"poison"} {_ammo %1};
    #case {"energy"} {_ammo %1};
    #case {"radiation"} {_ammo %1};
    #default {
      #showme Usage:;
      #showme - ammo <dmg type>;
      #showme - current setting: $jugger_ammo_type;
    };
  }
}

#alias attempt_airdrop {
  #math {sp_ratio} {$sp / $sp_max * 1.0};

  #if {$clan_powers > 0 && $rounds_in_combat > 0 && $gp2 < 60 && $sp_ratio < 0.3} {
    #send !airdrop;
  };
  #elseif {$clan_powers > 0 && $rounds_in_combat > 0 && $gp1 < 30 && $corpses < 1} {
    #send !airdrop;
  };
}

#alias check_stepper {
  #if {$corpses < 2 && $gp1 < 20 && "$stepper" == "on"} {stepper off};
  #else {
    #format {current_time} {%T};
    #math {time_since_stepper_started} {$current_time - $stepper_started};

    #if {"$stepper" == "on" && $time_since_stepper_started > 750} {
      stepper off;

      log.info Creating delay 'reactivate_stepper' to activate stepper after regen.;

      #nop Round is seconds * 2 (2s / round);
      #local min_seconds 10;
      #math rando {1 d 20};
      #math regen_time {$min_seconds + $rando};

      #delay {reactivate_stepper} {
        log.info "Re-activating stepper after regen time: $regen_time seconds.";
        stepper on;
      } {$regen_time};

      #unvar rando;
    };
  };
}

#alias f10 {use_corpse}

#alias f12 {
  #switch {$map[current_room]} {
    #case {11437} {
      #loop 2 $BAGS_TO_USE i {
        #send !get all from bag $i;
        #send !donate all;
      };
    };
    #case {11438} {
      #loop 2 $BAGS_TO_USE i {
        #loop 2 $BAGS_TO_USE i {
          #send !get all from bag $i;
          #send !donate all;
        };
      };
    };
    #default { #loop 2 $BAGS_TO_USE i {#send !sell all from bag $i} };
  };
}

#alias k {#send !kill %0; #send !ki %0;}

#alias login_commands {
  #delay 2 #send !support summon;
  #delay 4 #send !support assault $jugger_ammo_type;
  #delay 6 #send !cdefend support;
  #delay 8 {
    #send !empower on;
    set_afk;
  };
}

#alias mip_combat_hook {
  #if {$rounds_in_combat > 0 && $gp1 < 30 && $corpses > 0} {reco};

  #nop Use up excess sps on heat if i'm at full;
  #if {$rounds_in_combat > 0 && $gp2 < 70 && $sp >= $sp_max} {#send !dissipate};

  #nop Use up missiles and clan powers;
  #if {$clan_powers > 0 && $jugger_reset > 97} {#send !frenzy;};
  #if {$missiles > 0 && $rounds_in_combat > 0 && $jugger_reset > 97} {#send !fire $missiles};

  attempt_airdrop;
  check_stepper;
  #if {"$jugger_support_dead" == "true"} {sound_beep};
};

#alias mip_gline1_hook {
  #local data %0;
  #nop Example:;
  #nop Ammo:[500/] <yGxp: 83.5001%> Hits: [0] <cCoffin: N/A>;

  #regexp {$data} {Ammo:[{\d+}/} {#var jugger_mounts[0] &1};
  #regexp {$data} {Ammo:[{\d+}/{\d+}]} {#var jugger_mounts[1] &2} {#var jugger_mounts[1] 101};

  #if {$jugger_mounts[0] < 20} {reload 1 p $jugger_ammo_type};
  #if {$jugger_mounts[1] < 20} {reload 2 p $jugger_ammo_type};

  #regexp {$data} {Gxp: {\d+\.\d+}%} {#var gxp &1};
  #regexp {$data} {Coffin: {\d+}} {#var corpses &1} {#var corpses 0};
}

#alias mip_gline2_hook {
  #local data %0;
  #nop Example;
  #nop <rNukes: [3/3]> <vSupport: [3/4]> Reset: [65%] Suit: Elemental;
  #regexp {$data} {Nukes: [{\d+}/} {#var missiles &1};
  #regexp {$data} {Support: [{\d+}/} {#var clan_powers &1};
  #regexp {$data} {Reset: [{\d+}%]} {#var jugger_reset &1};
}

#nop  Remote Ammo (via truck) purchase;
#alias reload {
  #if {"%1" == ""} {
    #send !truck ammo list missile;
    #send !truck ammo list projectile;
    #showme <170>Syntax is 'reload <mount number> <ammo type> <dmg type>';
    #showme <170>Ex: reload 1 p radiation;
  };
  #elseif {"%1" == "guild"} {  
    run jugger_ammo;
    #switch {"%2"} {
      #case {"p"} {#send !vbuy projectile 1 1 500};
      #case {"m"} {#send !vbuy missile 1 1 500};
      #default {#showme Usage: reload guild <mount>};
    };
  }
  #else {
    #switch {"%2"} {
      #case {"m"} {
        #switch {"%3"} {
          #case {"fire"} {#send !truck ammo vbuy missile 2 %1 500};
          #case {"cold"} {#send !truck ammo vbuy missile 3 %1 500};
          #case {"poison"} {#send !truck ammo vbuy missile 4 %1 500};
          #case {"acid"} {#send !truck ammo vbuy missile 5 %1 500};
          #case {"radiation"} {#send !truck ammo vbuy missile 6 %1 500};
          #default {#send !truck ammo list missile};
        };
      };
      #case {"p"} {
        #switch {"%3"} {
          #case {"edged"} {#send !truck ammo vbuy projectile 2 %1 500};
          #case {"blunt"} {#send !truck ammo vbuy projectile 3 %1 500};
          #case {"fire"} {#send !truck ammo vbuy projectile 4 %1 500};
          #case {"radiation"} {#send !truck ammo vbuy projectile 5 %1 500};
          #case {"energy"} {#send !truck ammo vbuy projectile 6 %1 500};
          #default {#send !truck ammo list projectile}; 
        };
      };
    };
  };
}

#alias reco {
  #send !unwrap;
  #send !fdeener;
}

#alias set_afk {
  log.info Setting afk for juggers to get an 'airdrop';
  #send !afk Juggers, if you need an airdrop: 'high5' me;
}

#alias su_can {
  #send !support reset;
  #99 #send !support upgrade powerplant;
  #124 #send !support upgrade mount;
  #send !support assault fire,radiation,electric,ice,poison;
}

#alias su_def {
  #send !support defend edged,blunt,fire,ice,electric;
}

#alias su_reg {
  #send !support reset;
  #99 #send !support upgrade repair;
  #99 #send !support upgrade powerplant;
  #24 #send !support upgrade mount;
  #send !support assault fire;
}

#alias su_spam {
  #if {"%1" == "on"} {
    log.info Ansi ON for jugger support hits.;
    #send !aset jugg_support bkred;
  };
  #else {
    log.info Ansi OFF for jugger support hits.;
    #send !aset jugg_support hide;
  }
}

#alias su_tank {
  #send !support reset;
  #99 #send !support upgrade armor;
  #125 #send !support upgrade repair;
  #send !support defend edged,blunt,fire,ice,electric toggle;
}

#alias tr {
  #if {"%1" == "max"} {
    #send !transpose max;
  };
  #else {
    #send !transpose %1;
  };
}

#alias use_corpse {
  #send !hp;
  #send !fdeener;
}
