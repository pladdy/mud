#action {^%!{[> ]*}%1 rawrs menacingly at you.  RAAWWWRRR!} {
  #format {player} {%l} {%1};
  #send !frenzy $player;
  #unvar player;
}

#action {^%!{[> ]*}%1 gives you a high-five!$} {
  #format {player} {%l} {%1};
  #send !airdrop $player;
  #unvar player;
}

#action {^%!{[> ]*}From afar, %1 rawrs menacingly at you.  RAAWWWRRR!} {
  #format {player} {%l} {%1};
  #send !frenzy $player;
  #unvar player;
} {4}

#action {^%!{[> ]*}From afar, %1 gives you a high-five!$} {
  #format {player} {%l} {%1};
  #send !airdrop $player;
  #unvar player;
} {4}

#gag {^%!{[> ]*}The computer chirps 'No healing needed.'}

#alias _handle_fire_immune {
  #if {"$jugger_ammo_type" == "fire"} {
    ammo edged;
    #send !dump 1;
    #send !dump 2;
    dtrig ammo fire;
  };
}

#action {^%!{[> ]*}%1 (infernal).} {
  _handle_fire_immune;
} {2}

#action {^%!{[> ]*}[M] %1 (infernal).} {
  stepper_monster_trigger {%1};
  _handle_fire_immune;
} {1}


#action {^%!{[> ]*}Responding to %1's call for support, a Jugger Support Mech enters} {
  #var jugger_support_dead false;
}